################################################################################
# DEMO SEED CONFIGURATIONS (PREREQUISITE BEFORE DEPLOYING)
# --> Copy this file to <.env> at the repo root and set your REAL values.
# --> The <.env> file is gitignored: NEVER commit it (contains personal data).
# --> The CDK Data Seeder reads these values at synth/deploy time.
################################################################################

# Your REAL WhatsApp phone number (E.164 format) for the main demo user.
# It MUST be allowlisted in your META test app to receive messages.
DEMO_USER_PHONE_NUMBER=+573001234567

# Password for ALL the seeded Cognito demo users (portal login).
DEMO_USERS_PASSWORD=Password123.
